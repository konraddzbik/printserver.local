# Copy to config/printserver.env (chmod 600) and uncomment only what you change.
# Plain KEY=VALUE lines. The file is parsed, not executed, and unknown keys are rejected.
# Variables set on the command line take precedence over this file.

# CUPS queue name: letters, digits, '_', '.', '-'.
#PRINTER_NAME=Brother

# Device URI. Empty = auto-detect the single USB printer from `lpinfo -v`.
# Example: usb://Brother/HL-1110%20series?serial=XXXXXXX
#DEVICE_URI=

# Driver passed to `lpadmin -m`.
#   auto       → `everywhere` for ipp/ipps/dnssd URIs, matching brlaser PPD for USB
#   everywhere → IPP Everywhere (driverless)
#   drv:///brlaser.drv/br1110.ppd → explicit PPD (see `lpinfo -m | grep -i brlaser`)
#PRINTER_MODEL=auto

# Default media size (applied when the queue is created).
#PAPER_SIZE=A4

# Who can reach CUPS: "local" (Allow @LOCAL, recommended) or "any" (any network the Pi can see).
#NETWORK_ACCESS=local

# Expose the CUPS admin pages over the network: "no" (recommended) or "yes".
# AirPrint doesn't need it. Admin pages use your Pi login password over HTTP Basic auth.
#REMOTE_ADMIN=no

# Not configurable here, on purpose: PRINT_TEST_PAGE uses paper, so it's only
# honoured as an explicit per-run variable: PRINT_TEST_PAGE=1 ./scripts/verify.sh
