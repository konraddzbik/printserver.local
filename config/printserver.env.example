# Copy to config/printserver.env and adjust. Read by scripts/setup.sh and scripts/verify.sh.
# Every value is optional — sensible defaults (or auto-detection) apply when unset.

# CUPS queue name. No spaces, '/' or '#'.
PRINTER_NAME=Brother

# Device URI. Leave empty to auto-detect the first USB printer from `lpinfo -v`.
# Example: usb://Brother/HL-1110%20series?serial=XXXXXXX
DEVICE_URI=

# Driver / model passed to `lpadmin -m`.
#   auto      → `everywhere` for network IPP printers, brlaser for USB Brother host-based models
#   everywhere → IPP Everywhere (driverless)
#   drv:///brlaser.drv/br1110.ppd → explicit PPD (see `lpinfo -m | grep -i brlaser`)
PRINTER_MODEL=auto

# Default media size.
PAPER_SIZE=A4

# Who may reach CUPS: "local" (Allow @LOCAL, recommended) or "any" (cupsctl --remote-any).
NETWORK_ACCESS=local

# Set to 1 to print a real test page during verification (uses paper!).
PRINT_TEST_PAGE=0
